# データセットのホスト側パス (各サービスのコンテナ内 /app/data にマウントされる)
HOST_DATA_DIR_ANIME=/path/to/your/anime-style-dataset
HOST_DATA_DIR_FFHQ=/path/to/your/ffhq-dataset

# 各サービスが使うGPU番号 (並行学習するなら別の番号にする)
GPU_ANIME=0
GPU_FFHQ=1

# ベースイメージ (ホストのドライバが対応するCUDA以下を選ぶ)
BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
# CUDA違いのイメージを区別するタグ
IMAGE_TAG=cu121

# コンテナを実行するホストのユーザー (id -u / id -g の値)
HOST_UID=1000
HOST_GID=1000
