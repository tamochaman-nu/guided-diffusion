# データセットのホスト側パス (各サービスのコンテナ内 /app/data にマウントされる)
HOST_DATA_DIR_ANIME=/path/to/your/anime-style-dataset
HOST_DATA_DIR_FFHQ=/path/to/your/ffhq-dataset

# 各サービスが使う設定 (cfgs/<名前>.cfg)。ログは logs/anime-<名前>, logs/ffhq-<名前> に出る
# 例: 目の切り出し画像で 32x32 を学習するなら CFG_ANIME=eye32-mp128 (データのパスも目の画像に変える)
CFG_ANIME=mp128
CFG_FFHQ=mp128

# 各サービスが使うGPU番号 (並行学習するなら別の番号にする)
# 1 つの学習に 2 枚使う場合は GPU_ANIME=0,1 のようにカンマ区切りで指定する
# (BATCH_SIZE は 1 枚あたりの値。同じ GPU を使う他方のサービスは起動しないこと)
GPU_ANIME=0
GPU_FFHQ=1

# ベースイメージ (ホストのドライバが対応するCUDA以下を選ぶ)
BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
# CUDA違いのイメージを区別するタグ
IMAGE_TAG=cu121

# コンテナを実行するホストのユーザー (id -u / id -g の値)
HOST_UID=1000
HOST_GID=1000
